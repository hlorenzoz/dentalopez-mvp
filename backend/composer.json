{
  "name": "dentalopez/api",
  "type": "project",
  "require": {
    "php": "^8.3",
    "ext-intl": "*",
    "yiisoft/di": "*",
    "yiisoft/config": "*",
    "yiisoft/aliases": "*",
    "yiisoft/router": "*",
    "yiisoft/router-fastroute": "*",
    "yiisoft/yii-http": "*",
    "yiisoft/yii-runner-http": "*",
    "yiisoft/error-handler": "*",
    "yiisoft/middleware-dispatcher": "*",
    "httpsoft/http-message": "*",
    "httpsoft/http-server-request": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "mockery/mockery": "^1.6"
  },
  "autoload": { "psr-4": { "App\\": "src/" } },
  "autoload-dev": { "psr-4": { "App\\Tests\\": "tests/" } },
  "config": {
    "allow-plugins": { "yiisoft/config": true },
    "platform": { "php": "8.3.0" }
  },
  "scripts": {
    "test": "phpunit",
    "coverage": "phpunit --coverage-html=runtime/coverage --coverage-text"
  },
  "extra": {
    "config-plugin-options": {
      "output-directory": "config/packages",
      "source-directory": "config"
    },
    "config-plugin": {
      "common": "common/*.php",
      "params": "params.php",
      "params-web": ["$params"],
      "di": ["$common"],
      "di-web": ["$di", "web/*.php"],
      "events": "events.php",
      "events-web": ["$events", "events-web.php"],
      "providers": "providers.php",
      "providers-web": ["$providers", "providers-web.php"],
      "routes": "routes.php"
    }
  }
}
